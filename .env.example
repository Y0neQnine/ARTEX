# Docker 部署配置（复制为 .env）
# 二开版默认跑本地构建的镜像（docker compose --build 产出），不是上游 autumn27/artex。
ARTEX_IMAGE=artex
ARTEX_TAG=local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
